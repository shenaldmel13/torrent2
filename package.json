    "@vitejs/plugin-react": "^5.0.4",
    "archiver": "^8.0.0",
    "bytes": "^3.1.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.3.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
